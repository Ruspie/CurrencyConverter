<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Конвертер валют (REST API)</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Шрифт -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="dop_style.css">
</head>
<body>
<div class="container mt-5 main-wrapper">
    <h1 class="text-center mb-4 main-title">Конвертер валют</h1>

    <!-- Основной блок конвертера -->
    <div class="card mb-5 custom-card main-card-animation">
        <div class="card-body p-4">
            <div class="row mb-3">
                <div class="col-md-12">
                    <label for="amount" class="form-label">Сумма:</label>
                    <input type="number" class="form-control" id="amount" value="1" min="0.01" step="0.01">
                </div>
            </div>

            <div class="row align-items-end mb-3">
                <div class="col-md-5">
                    <label for="from-currency" class="form-label">Из:</label>
                    <select class="form-select" id="from-currency">
                        <!-- Наполняется динамически из API -->
                    </select>
                </div>

                <div class="col-md-2 text-center mb-1">
                    <button id="swap-btn" class="btn btn-outline-primary">⇄</button>
                </div>

                <div class="col-md-5">
                    <label for="to-currency" class="form-label">В:</label>
                    <select class="form-select" id="to-currency">
                        <!-- Наполняется динамически из API -->
                    </select>
                </div>
            </div>

            <button id="convert-btn" class="btn btn-success w-100 mb-3">Конвертировать</button>
            <div id="result" class="alert alert-info text-center" role="alert">Введите сумму для расчета</div>
        </div>
    </div>

    <!-- Блок популярных курсов -->
    <div class="card custom-card secondary-card-animation">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <h2 class="card-title h4 mb-0">Популярные курсы валют</h2>
            <p id="rates-count" class="text-muted small mb-0 status-badge"></p>
        </div>
        <div class="card-body">
            <div id="rates-container" class="row g-3">
                <!-- Наполняется динамически из API -->
            </div>
        </div>
    </div>
</div>

<!-- Библиотека для грандиозного эффекта взрыва конфетти -->
<!-- Скрипт конфетти -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="script.js"></script>
</body>
</html>